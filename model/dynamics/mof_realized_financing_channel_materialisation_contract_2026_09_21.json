  "currency_and_conversion_contract": {
    "provider_published_RON_equivalent_values_may_be_retained_exactly": true,
    "provider_conversion_metadata_must_be_retained_per_vintage": true,
    "same_conversion_convention_may_not_be_assumed_across_vintages": true,
    "native_currency_fields_must_remain_separate_when_explicitly_published": true,
    "cross_currency_reaggregation_by_RMD_authorized_now": false,
    "exchange_rate_series_selected_by_this_contract": false,
    "reason": "Foreign-currency borrowing can be represented in Ministry reports using stated forecast-average exchange-rate conventions. Exact published values are admissible as vintage observations, but month-to-month differences are not definitionally safe until conversion conventions are matched."
  },
  "revision_and_vintage_contract": {
    "each_monthly_report_is_a_distinct_source_vintage": true,
    "later_report_may_revise_prior_cumulative_values": true,
    "later_vintage_may_not_silently_overwrite_earlier_vintage": true,
    "revision_check_required_before_monthly_differencing": true,
    "definition_check_required_before_monthly_differencing": true,
    "reporting_cutoff_alignment_required_before_monthly_differencing": true,
    "negative_difference_may_not_be_interpreted_as_negative_borrowing_without_revision_or_operation_review": true
  },
  "monthly_increment_gate": {
    "monthly_differencing_authorized_now": false,
    "requirements_before_any_difference": [
      "current and previous report use the same instrument/channel definitions",
      "current and previous report use a matched currency-conversion convention or exact native-currency values",
      "revision status of prior cumulative values is reconciled",
      "exchange operations included in Treasury-bond lines are identified and treated consistently",
      "cash-management instruments are kept on their declared boundary",
      "local-government borrowing remains outside central-government totals",
      "both source vintages are retained with exact provenance"
    ],
    "difference_equation_if_all_future_gates_pass": "monthly_increment[channel,t] = cumulative_ytd[channel,t] - reconciled_cumulative_ytd[channel,t-1]",
    "equation_status_now": "NOT_AUTHORIZED"
  },
  "channel_boundary_rules": {
    "BNR_domestic_primary_market_series_is_separate": true,
    "equality_with_BNR_is_not_a_validation_requirement": true,
    "BNR_series_may_not_be_inferred_by_subtraction": true,
    "securities_only_subset_must_exclude_loans_and_RRF_drawings": true,
    "domestic_interbank_channel_may_not_absorb_retail_by_default": true,
    "total_realized_borrowing_may_not_be_relabelled_government_financing_need": true,
    "gross_financing_need_may_not_be_used_as_residual_reconciliation_target": true
  },
  "hard_rules": {
    "no_monthly_differencing_in_this_contract": true,
