    {
      "authority": "Vensim documentation",
      "url": "https://www.vensim.com/documentation/euler.html",
      "role": "Explicit Euler numerical-error semantics",
      "retained_rule": "Euler global error scales with TIME STEP; reducing TIME STEP improves accuracy."
    },
    {
      "authority": "isee systems / STELLA documentation",
