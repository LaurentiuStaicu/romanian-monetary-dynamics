{
  "contract_version": "0.1",
  "purpose": "Make dimensional semantics executable for every currently mapped behavioural implementation without inventing empirical scales, parameter values or activation authority.",
  "scope": "Every non-null implementation in model/empirical_dynamics/mechanism_registry.json.",
  "principles": [
    "Symbolic dimensional consistency is distinct from empirical measurement-scale readiness.",
    "A dimensionless economic ratio still requires an explicit representation scale before estimation (for example fraction versus percentage points).",
    "A discrete-period share used as a convex weight is dimensionless even when its interpretation refers to the share repriced during that period.",
    "Passing this unit gate is necessary but never sufficient for calibration admission, System Dynamics feedback activation or behavioural closure."
  ],
  "unit_classes": {
    "rate_level_pp_per_annum": {
      "dimension": "dimensionless_rate_level",
      "representation": "percentage_points_per_annum"
    },
    "dimensionless_period_share": {
      "dimension": "dimensionless",
      "representation": "fraction_of_stock_realised_within_declared_period",
      "admissible_bounds": [
        0,
        1
      ]
    },
    "period_growth_fraction": {
      "dimension": "dimensionless",
      "representation": "fractional_growth_over_declared_observation_period",
      "empirical_scale_must_be_frozen_before_estimation": true
    },
    "ratio_level_scale_unfrozen": {
      "dimension": "dimensionless",
      "representation": "ratio_level_with_fraction_vs_percentage_point_scale_not_yet_frozen",
      "empirical_scale_must_be_frozen_before_estimation": true
    },
    "ratio_change_per_period_scale_unfrozen": {
      "dimension": "dimensionless",
      "representation": "change_in_ratio_over_declared_observation_period_with_scale_not_yet_frozen",
      "empirical_scale_must_be_frozen_before_estimation": true
    },
    "dimensionless_growth_to_growth": {
      "dimension": "dimensionless",
      "representation": "output_growth_unit_per_input_growth_unit_when_both_use_the_same_frozen_transform"
    },
    "growth_fraction_per_rate_pp_per_annum": {
      "dimension": "transform_coefficient",
      "representation": "period_growth_fraction_per_percentage_point_per_annum"
    },
    "growth_fraction_per_ratio_unit": {
      "dimension": "transform_coefficient",
      "representation": "period_growth_fraction_per_frozen_ratio_unit"
    },
    "ratio_change_per_growth_fraction": {
      "dimension": "transform_coefficient",
      "representation": "ratio_change_per_period_per_growth_fraction"
    },
    "ratio_change_per_ratio_unit": {
      "dimension": "transform_coefficient",
      "representation": "ratio_change_per_period_per_frozen_ratio_unit"
    },
    "ratio_change_per_ratio_level": {
      "dimension": "transform_coefficient",
      "representation": "ratio_change_per_period_per_frozen_ratio_level_unit"
    },
    "dimensionless_rate_change_pass_through": {
      "dimension": "dimensionless",
      "representation": "lending_rate_change_per_policy_rate_change_with_both_rates_in_percentage_points_per_annum"
    }
  },
  "hard_rules": {
    "every_current_implementation_requires_unit_contract": true,
    "every_parameter_requires_explicit_unit_class": true,
    "every_input_requires_explicit_unit_class": true,
    "all_additive_terms_must_match_output_unit_class": true,
    "unfrozen_measurement_scale_blocks_unit_activation_readiness": true,
    "unit_gate_never_authorizes_model_activation": true
  },
  "equations": [
    {
      "mechanism_id": "monetary_policy_lending_rate_pass_through",
